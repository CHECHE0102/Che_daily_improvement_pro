"se fueron; quedan", "en": "went away; remaining", "pos": "v.", "base": "leave", "lvl": "A2"}, "imported": {"zh": "進口的", "hi": "आयातित", "es": "importado", "en": "brought from abroad", "pos": "adj.", "base": "imported", "lvl": "B2"}, "food": {"zh": "食物", "hi": "भोजन", "es": "comida", "en": "what we eat", "pos": "n.", "base": "food", "lvl": "A1"}, "up": {"zh": "向上（up to：多達）", "pos": "adv.", "base": "up", "hi": "तक (up to: अधिकतम)", "en": "(up to: as many as)", "es": "hasta (up to)", "lvl": "A1"}, "reliance": {"zh": "依賴", "hi": "निर्भरता", "es": "dependencia", "en": "depending on", "pos": "n.", "base": "reliance", "lvl": "C1"}, "furthermore": {"zh": "此外", "hi": "इसके अलावा", "es": "además", "en": "also; in addition", "pos": "adv.", "base": "furthermore", "lvl": "C1"}, "so": {"zh": "所以", "hi": "इसलिए", "es": "así que", "en": "therefore", "pos": "conj.", "base": "so", "lvl": "A1"}, "securing": {"zh": "獲得；確保", "hi": "प्राप्त करना", "es": "asegurar", "en": "getting", "pos": "v.", "base": "secure", "lvl": "C1"}, "tropical": {"zh": "熱帶的", "hi": "उष्णकटिबंधीय", "es": "tropical", "en": "from hot parts of the world", "pos": "adj.", "base": "tropical", "lvl": "B2"}, "heavily": {"zh": "大量地；嚴重地", "hi": "बहुत अधिक", "es": "en gran medida", "en": "very much", "pos": "adv.", "base": "heavily", "lvl": "B2"}, "originates": {"zh": "源自", "hi": "से आता है", "es": "procede", "en": "comes from", "pos": "v.", "base": "originate", "lvl": "C1"}, "consolidated": {"zh": "整併；集中", "hi": "एकीकृत हुआ", "es": "se ha concentrado", "en": "joined into fewer, bigger units", "pos": "v.", "base": "consolidate", "lvl": "C1"}, "committing": {"zh": "承諾", "hi": "प्रतिबद्ध होना", "es": "comprometiéndose", "en": "promising to do", "pos": "v.", "base": "commit", "lvl": "B2"}, "present": {"zh": "現在（at present：目前）", "hi": "वर्तमान (at present: अभी)", "es": "actualmente (at present)", "en": "now (at present)", "pos": "n.", "base": "present", "lvl": "B1"}, "gone": {"zh": "（go up/down 的過去分詞）", "hi": "गया", "es": "subido; bajado", "en": "past participle of \"go\"", "pos": "v.", "base": "go", "lvl": "A1"}}, "id": "2026-10-11-2", "summaryHi": "आयरलैंड अपने 80% से अधिक फल-सब्ज़ियाँ आयात करता है; सब्ज़ी उत्पादक 600 से घटकर 70 से कम।", "summaryEn": "Ireland imports over 80% of its fruit and veg; vegetable growers fell from 600 to under 70.", "summaryEs": "Irlanda importa más del 80 % de su fruta y verdura; los productores bajaron de 600 a menos de 70.", "levels": {"B2": {"paragraphs": ["Ireland imports most of the fruit and vegetables it eats. According to the Climate Change Advisory Council, around 83 per cent of the fresh produce consumed in the country comes from abroad. Some of this is unavoidable, since crops such as bananas and oranges simply cannot be grown in the Irish climate.", "The number of commercial vegetable growers has also fallen sharply. In the 1990s there were more than 600; today there are fewer than 70. However, production has not dropped at the same rate, because the industry is now concentrated in a small number of large, specialised farms.", "Growers face several challenges. This summer was the hottest on record, and research by Teagasc found that crops without irrigation lost between a quarter and two-fifths of their yield. Labour accounts for more than 40 per cent of costs, and many farmers struggle to find workers or someone to take over the business.", "There are some signs of support. Six supermarkets have signed a charter promising longer contracts with growers, and experts suggest that new technology, such as robotics, could reduce the need for manual work."]}, "B1": {"paragraphs": ["Ireland buys most of its fruit and vegetables from other countries. About 83 per cent of the fresh fruit and vegetables that people eat here comes from abroad, says the Climate Change Advisory Council. Some foods, like bananas and oranges, cannot grow in Ireland's weather.", "There are also far fewer vegetable farmers than before. In the 1990s there were more than 600. Today there are fewer than 70. But the farms that are left are bigger, so the total amount of food has not gone down as much.", "Farmers have many problems. This summer was the hottest ever recorded, and farms without enough water lost up to two-fifths of their crops. Workers are expensive, and many farmers cannot find staff or a person to take over the farm.", "There is some good news. Six supermarkets have promised to sign longer contracts with farmers, and experts say robots could help with some of the hard work."]}, "C1": {"paragraphs": ["Ireland relies overwhelmingly on imports for its fruit and vegetables. According to the Climate Change Advisory Council, roughly 83 per cent of the fresh produce consumed in the country is sourced from abroad. A proportion of this is inevitable, given that crops such as bananas and citrus fruit simply cannot be cultivated in the Irish climate.", "The ranks of commercial vegetable growers have also thinned dramatically, from more than 600 in the 1990s to fewer than 70 today. Output, however, has not declined at the same pace, as the sector has consolidated into a handful of large, specialised operations.", "Growers are contending with mounting pressures. This summer was the hottest on record, and research by Teagasc found that unirrigated crops forfeited between a quarter and two-fifths of their yield. Labour accounts for over 40 per cent of costs, and many farmers struggle to recruit workers or identify a successor.", "There are tentative signs of support. Six supermarkets have signed a charter committing to longer contracts with growers, while experts believe automation and robotics could ease the reliance on manual labour."]}, "IELTS": {"paragraphs": ["Ireland is heavily dependent on imported fruit and vegetables. The Climate Change Advisory Council estimates that approximately 83 per cent of the fresh produce consumed nationally originates abroad. To some extent, this is unavoidable, since tropical and citrus crops cannot be grown commercially in the Irish climate.", "Furthermore, the number of commercial vegetable producers has declined markedly, falling from over 600 in the 1990s to fewer than 70 at present. Nevertheless, total output has not decreased proportionally, because production has become concentrated among a small number of large, specialised enterprises.", "The sector faces a range of challenges. This summer was the warmest ever recorded, and a study by Teagasc indicated that crops lacking irrigation suffered yield losses of between 25 and 40 per cent. Labour constitutes more than 40 per cent of production costs, and many farmers report difficulties in recruiting staff or securing a successor.", "Nonetheless, there are indications of support. Six supermarkets have endorsed a charter guaranteeing growers longer-term contracts, and experts suggest that investment in robotics could reduce the sector's dependence on manual labour."]}}}