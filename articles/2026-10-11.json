.", "base": "claim", "hi": "दावा करता है", "en": "says something is true", "es": "afirma"}, "close": {"zh": "關閉", "pos": "v.", "base": "close", "hi": "बंद होना", "en": "to shut", "es": "cerrar"}, "compromise": {"zh": "妥協；折衷方案", "pos": "n.", "base": "compromise", "note": {"meaning": "妥協、折衷方案，雙方各讓一步。", "usage": "reach a compromise 是最常見搭配；當動詞也可指「損害」，例如 compromise safety。", "collocations": ["reach a compromise", "make compromises", "a fair compromise"], "example": {"en": "After hours of talks, they finally reached a compromise.", "zh": "談了幾個小時後，他們終於達成妥協。"}}, "hi": "समझौता", "en": "an agreement where both sides give up something", "noteHi": {"meaning": "समझौता, जिसमें दोनों पक्ष कुछ छोड़ते हैं।", "usage": "reach a compromise सबसे आम; क्रिया के रूप में 'नुक़सान पहुँचाना' भी।", "exampleTr": "घंटों बातचीत के बाद वे समझौते पर पहुँचे।"}, "noteEn": {"meaning": "An agreement where each side gives up something.", "usage": "'reach a compromise'; as a verb it can also mean 'to damage' (compromise safety)."}, "es": "acuerdo; término medio", "noteEs": {"meaning": "Acuerdo en el que cada parte cede algo.", "usage": "'reach a compromise'; como verbo también 'poner en riesgo'.", "exampleTr": "Tras horas de negociación, llegaron a un acuerdo."}}, "conditions": {"zh": "條件", "pos": "n.", "base": "condition", "hi": "शर्तें", "en": "things that must be agreed first", "es": "condiciones"}, "continue": {"zh": "繼續", "pos": "v.", "base": "continue", "hi": "जारी रहना", "en": "to keep happening", "es": "continuar"}, "could": {"zh": "可能；可以", "pos": "v.", "base": "could", "hi": "सकता था; संभव है", "en": "might; was able to", "es": "podría"}, "daily": {"zh": "日常的；每天的", "pos": "adj.", "base": "daily", "hi": "रोज़ाना", "en": "happening every day", "es": "diario"}, "day": {"zh": "天；日", "pos": "n.", "base": "day", "hi": "दिन", "en": "24 hours", "es": "día"}, "deal": {"zh": "協議；交易", "pos": "n.", "base": "deal", "hi": "सौदा; समझौता", "en": "an agreement", "es": "acuerdo"}, "dentists": {"zh": "牙醫", "pos": 